---
import type { Fragment } from '../../lib/types';
import ShotMedia from './ShotMedia.astro';

interface Props {
  fragment: Fragment;
  cls?: string;
}

const { fragment: f, cls = '' } = Astro.props;
---

<a
  href={`/f/${f.id}`}
  class:list={['tile', 'tile-shot', 'shot-evidence', cls]}
  data-type="shot"
  aria-label={f.title}
>
  <ShotMedia media={f.images![0]} title={f.title} />
  <div class="shot-marker">{f.id}</div>
</a>
